package kfvm.cli

class Usage {
    static String VERSION = "0.3.0"

    static String text(String home) {
        return "kfvm " + VERSION + " — Kof Version Manager\n" +
            "\n" +
            "Usage:\n" +
            "  kfvm ls,  list [-r, --remote]          list installed versions (or available ones)\n" +
            "  kfvm i,   install <ver|lst|nightly>    install a version\n" +
            "  kfvm u,   use <ver|lst|nightly>        switch the active version\n" +
            "  kfvm uni, uninstall <ver|lst|nightly>  remove an installed version\n" +
            "\n" +
            "Versions:\n" +
            "  <ver>      exact version, e.g. 0.4.10-beta (prefix match allowed: 0.4.10)\n" +
            "  lst        latest stable release\n" +
            "  nightly    latest pre-release (e.g. 0.5.0-beta+2026.09.25)\n" +
            "\n" +
            "Install dir: " + home
    }
}
