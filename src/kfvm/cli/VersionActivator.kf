package kfvm.cli

import kfvm.system
import kfvm.platform
import kfvm.store

class VersionActivator {
    Store store
    kfvm.platform.UserPath userPath
    Console console

    constructor(Store store, kfvm.platform.UserPath userPath, Console console) {
        this.store = store
        this.userPath = userPath
        this.console = console
    }

    void activate(String version) {
        store.activate(version)
        console.info("now using kof " + version)
        if (userPath.include(store.currentBin())) {
            console.info("added kof to your PATH (open a new terminal to use it)")
        }
    }
}
