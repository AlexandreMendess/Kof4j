package kfvm.cli

import kfvm.system
import kfvm.store

class InstallCommand implements kfvm.cli.Command {
    RemoteVersions remote
    Store store
    VersionActivator activator
    Console console

    constructor(RemoteVersions remote, Store store, VersionActivator activator, Console console) {
        this.remote = remote
        this.store = store
        this.activator = activator
        this.console = console
    }

    List<String> names() { return listOf("i", "install") }

    void run(List<String> args) {
        if (args.size == 0) {
            throw "usage: kfvm i <ver|lst|nightly>"
        }
        var releases = remote.releases()
        var version = remote.resolve(args.get(0), releases)
        remote.ensureInstalled(version, releases)
        var current = store.current()
        if (current == "" || current == version) {
            activator.activate(version)
        } else {
            console.info("run 'kfvm u " + version + "' to activate it")
        }
    }
}
