package kfvm.store

import kof.io
import kfvm.system
import kfvm.versions

class Store {
    String home
    String platform

    constructor(String home, String platform) {
        this.home = home
        this.platform = platform
    }

    String root() { return home }

    String dirName(String version) { return "kof-" + version + "-" + platform }

    String dirOf(String version) { return home + "/" + dirName(version) }

    String currentLink() { return home + "/current" }

    Bool isInstalled(String version) {
        return File(dirOf(version) + "/bin/kof").exists()
    }

    List<String> installed() {
        var found: List<String> = listOf()
        if (!Directory(home).exists()) {
            return found
        }
        for (var name in Directory(home).list()) {
            var version = versionOf(name)
            if (version != "" && isInstalled(version)) {
                found.add(version)
            }
        }
        return Versions.sortAscending(found)
    }

    List<Candidate> installedNewestFirst() {
        var versions = installed()
        var out = listOf<Candidate>()
        for (var i = versions.size - 1; i >= 0; i--) {
            out.add(Candidate(versions.get(i), false))
        }
        return out
    }

    String current() {
        if (!File(currentLink()).isSymlink()) {
            return ""
        }
        var target = Shell.run("readlink", listOf(currentLink())).trim()
        return versionOf(Path(target).fileName())
    }

    void activate(String version) {
        Shell.run("ln", listOf("-sfn", dirOf(version), currentLink()))
    }

    void deactivate() {
        Shell.run("rm", listOf("-f", currentLink()))
    }

    void remove(String version) {
        Shell.run("rm", listOf("-rf", dirOf(version)))
    }

    String versionOf(String name) {
        var suffix = "-" + platform
        if (!name.startsWith("kof-") || !name.endsWith(suffix)) {
            return ""
        }
        return name.substring(4, name.length - suffix.length)
    }
}
