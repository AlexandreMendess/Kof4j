package kfvm.system

import kof.shell

class Shell {
    static String run(String program, List<String> args) {
        var r = shell.run(program, args)
        if (!shell.ok(r)) {
            throw program + " failed: " + r.stderr.trim()
        }
        return r.stdout
    }

    static Bool succeeds(String program, List<String> args, String cwd) {
        var r = shell.runWith(shell.cmd(program, args), cwd, mapOf())
        return shell.ok(r)
    }

    static Bool available(String program) {
        var r = shell.run("which", listOf(program))
        return shell.ok(r)
    }
}
