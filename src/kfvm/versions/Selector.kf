package kfvm.versions

class Selector {
    static Bool isChannel(String query) {
        return query == "lst" || query == "latest" || query == "nightly"
    }

    static String select(String query, List<Candidate> newestFirst) {
        var want = if (query.startsWith("v")) query.substring(1) else query
        if (isChannel(want)) {
            return newestOfChannel(want == "nightly", newestFirst)
        }
        var match = ""
        var count = 0
        for (var c in newestFirst) {
            if (c.version() == want) { return want }
            if (c.version().startsWith(want + "-") || c.version().startsWith(want + "+")) {
                match = c.version()
                count = count + 1
            }
        }
        return if (count == 1) match else ""
    }

    static String newestOfChannel(Bool nightly, List<Candidate> newestFirst) {
        for (var c in newestFirst) {
            if (c.nightly() == nightly) { return c.version() }
        }
        return ""
    }
}
