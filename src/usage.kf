usage(home: String) {
    println("kfvm 0.2.0 — Kof Version Manager\n")
    println("Usage:")
    println("  kfvm ls,  list [-r, --remote]          list installed versions (or available ones)")
    println("  kfvm i,   install <ver|lst|nightly>    install a version")
    println("  kfvm u,   use <ver|lst|nightly>        switch the active version")
    println("  kfvm uni, uninstall <ver|lst|nightly>  remove an installed version\n")
    println("Versions:")
    println("  <ver>      exact version, e.g. 0.4.10-beta (prefix match allowed: 0.4.10)")
    println("  lst        latest stable release")
    println("  nightly    latest pre-release (e.g. 0.5.0-beta+2026.09.25)\n")
    println("Install dir: " + home)
}
