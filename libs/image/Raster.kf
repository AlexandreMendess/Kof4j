package image

import image.Image

// kof.image — raw raster decode, first pixel slice (provisional surface).
//
// `decodeRaster(path)` returns the pixel samples of an **uncompressed** image
// (no codec, no decompression engine): the Kof-first half of the pixel slice.
// Compressed formats (PNG/JPEG/…) stay interop-first (R9) behind a later
// maintainer-decided `kof.image` surface.
//
//   var r = decodeRaster("shot.ppm")
//   println(r.width + "x" + r.height + " ch=" + r.channels)
//   var red = r.samples[0]                 // row-major, channels interleaved, 0..255
//
// Supported now: **PNM** `P5` (grayscale) / `P6` (RGB), 8-bit, **farbfeld**
// (16-bit RGBA downsampled to 8-bit) and **BMP** 24/32-bit uncompressed (BGR
// rows padded to 4 bytes; alpha dropped). Documented bounds: the
// sample count must be <= 16384 (one bounded read; keeps the single array
// under the cross-native allocation cap, `known-bugs` §540) and the value must
// fit an 8-bit sample. Anything else (a compressed format, a larger raster, a
// 16-bit PNM, comments in the pixel area) throws a `String` beginning with
// `IMAGE:` — never a silent wrong decode. `cropRaster`, `resizeNearest`,
// `flipHorizontal`/`flipVertical` and `rotate90` operate on a `Raster` in pure
// Kof (nearest-neighbour; smooth filtering rides the interop slice); their
// output is bounded by the same cap.
//
// The final `Image`/`Pixel`/`Color` value surface and the imageio bindings are
// a rule-6 decision (see the plan); this `Raster` view is provisional and
// additive. Built on `kof.io.readRange`; JS inherits the `IOJS001` gap.

record Raster(String format, Int width, Int height, Int channels, Int[] samples)

Raster decodeRaster(String path) {
    var img = Image(path)
    var fmt = img.format()
    if (fmt == "farbfeld") {
        return farbfeldRaster(path, img.width(), img.height())
    }
    if (fmt == "PPM" || fmt == "PGM") {
        return pnmRaster(path, img.width(), img.height(), fmt == "PPM")
    }
    if (fmt == "BMP") {
        return bmpRaster(path)
    }
    throw "IMAGE: raster decode is not supported for " + fmt
}

Raster pnmRaster(String path, Int w, Int h, Bool color) {
    var channels = 1
    if (color) {
        channels = 3
    }
    var count = w * h * channels
    guardRaster(count)
    var head = File(path).readRange(0, count + 64)
    var start = rasterDataStart(head)
    var samples = new Int[count]
    var i = 0
    while (i < count) {
        samples[i] = head[start + i] & 255
        i = i + 1
    }
    return Raster(buildPnmName(color), w, h, channels, samples)
}

// Uncompressed BMP (24/32-bit, no palette): rows padded to 4 bytes, stored
// bottom-up unless the height is negative (top-down); BGR(A) -> RGB.
Raster bmpRaster(String path) {
    var head = File(path).readRange(0, 64)
    var offset = le32(head, 10)
    var w = le32(head, 18)
    var h = le32(head, 22)
    var topDown = false
    if (h < 0) {
        h = 0 - h
        topDown = true
    }
    var bpp = le16(head, 28)
    if (w <= 0 || h <= 0) {
        throw "IMAGE: invalid BMP dimensions"
    }
    if (bpp != 24 && bpp != 32) {
        throw "IMAGE: unsupported BMP bit depth " + bpp
    }
    var channels = 3
    var count = w * h * channels
    guardRaster(count)
    var rowBytes = ((w * bpp / 8 + 3) / 4) * 4
    var data = File(path).readRange(offset, rowBytes * h)
    var samples = new Int[count]
    var row = 0
    while (row < h) {
        var srcRow = row
        if (!topDown) {
            srcRow = h - 1 - row
        }
        var col = 0
        while (col < w) {
            var p = srcRow * rowBytes + col * (bpp / 8)
            samples[(row * w + col) * channels] = data[p + 2] & 255
            samples[(row * w + col) * channels + 1] = data[p + 1] & 255
            samples[(row * w + col) * channels + 2] = data[p] & 255
            col = col + 1
        }
        row = row + 1
    }
    return Raster("BMP", w, h, channels, samples)
}

Raster farbfeldRaster(String path, Int w, Int h) {
    var count = w * h * 4
    guardRaster(count)
    var bytes = File(path).readRange(16, count * 2)
    var samples = new Int[count]
    var i = 0
    while (i < count) {
        samples[i] = bytes[i * 2] & 255
        i = i + 1
    }
    return Raster("farbfeld", w, h, 4, samples)
}

guardRaster(Int count) {
    if (count <= 0) {
        throw "IMAGE: empty raster"
    }
    if (count > 16384) {
        throw "IMAGE: raster too large for this slice (max 16384 samples)"
    }
}

Raster cropRaster(Raster r, Int x, Int y, Int w, Int h) {
    if (x < 0 || y < 0 || w <= 0 || h <= 0 || x + w > r.width || y + h > r.height) {
        throw "IMAGE: crop rectangle out of bounds"
    }
    var count = w * h * r.channels
    guardRaster(count)
    var out = new Int[count]
    var row = 0
    while (row < h) {
        var srcRow = (y + row) * r.width
        var dstRow = row * w
        var col = 0
        while (col < w) {
            var c = 0
            while (c < r.channels) {
                out[(dstRow + col) * r.channels + c] = r.samples[(srcRow + x + col) * r.channels + c]
                c = c + 1
            }
            col = col + 1
        }
        row = row + 1
    }
    return Raster(r.format, w, h, r.channels, out)
}

Raster resizeNearest(Raster r, Int w, Int h) {
    if (w <= 0 || h <= 0) {
        throw "IMAGE: invalid resize size"
    }
    var count = w * h * r.channels
    guardRaster(count)
    var out = new Int[count]
    var row = 0
    while (row < h) {
        var srcRow = row * r.height / h
        var col = 0
        while (col < w) {
            var srcCol = col * r.width / w
            var c = 0
            while (c < r.channels) {
                out[(row * w + col) * r.channels + c] = r.samples[(srcRow * r.width + srcCol) * r.channels + c]
                c = c + 1
            }
            col = col + 1
        }
        row = row + 1
    }
    return Raster(r.format, w, h, r.channels, out)
}

Raster flipHorizontal(Raster r) {
    guardRaster(r.samples.length)
    var out = new Int[r.samples.length]
    var row = 0
    while (row < r.height) {
        var col = 0
        while (col < r.width) {
            var c = 0
            while (c < r.channels) {
                var src = (row * r.width + (r.width - 1 - col)) * r.channels + c
                out[(row * r.width + col) * r.channels + c] = r.samples[src]
                c = c + 1
            }
            col = col + 1
        }
        row = row + 1
    }
    return Raster(r.format, r.width, r.height, r.channels, out)
}

Raster flipVertical(Raster r) {
    guardRaster(r.samples.length)
    var out = new Int[r.samples.length]
    var row = 0
    while (row < r.height) {
        var col = 0
        while (col < r.width) {
            var c = 0
            while (c < r.channels) {
                var src = ((r.height - 1 - row) * r.width + col) * r.channels + c
                out[(row * r.width + col) * r.channels + c] = r.samples[src]
                c = c + 1
            }
            col = col + 1
        }
        row = row + 1
    }
    return Raster(r.format, r.width, r.height, r.channels, out)
}

// Clockwise 90 degrees; the dimensions swap (`W'=H`, `H'=W`).
Raster rotate90(Raster r) {
    guardRaster(r.samples.length)
    var out = new Int[r.samples.length]
    var y = 0
    while (y < r.width) {
        var x = 0
        while (x < r.height) {
            var c = 0
            while (c < r.channels) {
                var src = ((r.height - 1 - x) * r.width + y) * r.channels + c
                out[(y * r.height + x) * r.channels + c] = r.samples[src]
                c = c + 1
            }
            x = x + 1
        }
        y = y + 1
    }
    return Raster(r.format, r.height, r.width, r.channels, out)
}

String buildPnmName(Bool color) {
    if (color) {
        return "PPM"
    }
    return "PGM"
}

// Offset of the first raster byte in a P5/P6 header (`P5/P6`, width, height,
// maxval, one whitespace, data). Comments are not allowed inside the data.
Int rasterDataStart(Int[] b) {
    var i = 2
    i = rasterSkip(b, i)
    i = rasterDigits(b, i)
    i = rasterSkip(b, i)
    i = rasterDigits(b, i)
    i = rasterSkip(b, i)
    i = rasterDigits(b, i)
    if (i < b.length && rasterIsSpace(b[i])) {
        i = i + 1
    }
    return i
}

Int rasterSkip(Int[] b, Int from) {
    var p = from
    while (p < b.length && rasterIsSpace(b[p])) {
        p = p + 1
    }
    return p
}

Int rasterDigits(Int[] b, Int from) {
    var p = from
    while (p < b.length && b[p] >= 48 && b[p] <= 57) {
        p = p + 1
    }
    return p
}

Bool rasterIsSpace(Int c) {
    return c == 32 || c == 9 || c == 10 || c == 13
}
