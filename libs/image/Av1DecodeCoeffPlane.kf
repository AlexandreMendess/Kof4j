package image

import image.Av1Block
import image.Av1CoeffPlane
import image.Av1Coeffs
import image.Av1DecodeBlock
import image.Av1IntraAvail
import image.Av1IntraBlock
import image.Av1ReconBlock
import image.Av1Symbol
import image.Av1Tx

// kof.image — AV1 intra coefficient-driven predict+reconstruct plane driver
// (slice 3ad of the AVIF front, plan §34). This is the stage libaom runs as the
// intra loop of `decode_token_recon_block` (`av1/decoder/decodeframe.c:908`)
// with the coefficient values coming from the REAL tile entropy stream — the
// pairing
//
//   read_coeffs_tx_intra_block(plane, blk_row, blk_col)   ->  av1_read_coeffs_txb
//   predict_and_reconstruct_intra_block(...)              ->  av1_predict_intra_block
//                                                             + inverse_transform_block
//
// in that order, per transform block. Slice 3ac composed prediction and
// reconstruction over a deterministic level pattern; this slice replaces the
// pattern with the levels the slice-3e coefficient walk actually decodes, so the
// whole intra plane decode is driven by the tile bitstream.
//
// Per block of the slice-3y enumeration order:
//
//   1. decode the block's coefficients (slices 3e/3x: neighbour context from
//      the plane's above/left store -> `coeffs()` walk -> packed-context store),
//   2. derive the block's availability (slice 3ab `av1IntraAvail`),
//   3. predict it from the already reconstructed neighbours (slice 3u), and
//   4. dequantize + inverse-transform + add into the plane (slice 3z
//      `av1ReconBlockInto`) with the DECODED levels.
//
// Because step 1 runs before step 3 of the SAME block and before every later
// block, a later transform block predicts from samples the earlier ones already
// reconstructed — exactly libaom's interleaving.
//
// Pure Kof, all targets: no I/O, no compiler change. `decodeRaster` still
// refuses AVIF until the chain closes (mode-info block walk + chroma).

// The coefficient-driven intra plane driver. Parameters mirror the slice-3ac
// `av1DecodeReconBlockPlane` plus the coefficient-decode inputs (slice 3x):
//
//   - `frame`/`stride`/`frameW`/`frameH`: the plane buffer with its one-sample
//     border (the interior lives at `[1 .. frameW] x [1 .. frameH]`).
//   - `bsize`: the mode-info block size (the plane's extent).
//   - `txSz`/`txType`: the plane's transform size and type.
//   - `mode`/`angleDelta`/`useFilterIntra`/`filterIntraMode`: the intra
//     prediction mode (slice 3u).
//   - `bitDepth`: 8, 10 or 12.
//   - `disableEdgeFilter`/`intraEdgeFilterType`: the §7.11.2.8-§7.11.2.12 edge
//     filter controls (`disableEdgeFilter` is `!enable_intra_edge_filter`).
//   - `maxBlocksWide`/`maxBlocksHigh`: the plane's 4x4-unit extents.
//   - `dcQuant`/`acQuant`: the dequantization factors (slice 3f).
//   - `reader`/`store`: the tile symbol decoder and its adapting coefficient CDF
//     store (slice 3e).
//   - `planeBsize`/`plane`: the plane residual block size index and plane id.
//   - `planeBlocksWide`/`planeBlocksHigh`: the plane's valid 4x4-unit counts for
//     the context-store clamp (0 = no edge).
//   - `above`/`left`: the plane's above/left entropy-context arrays.
//   - `levelsOut`: receives the decoded signed coefficient array of every block,
//     in enumeration order (the caller-visible decode record).
//
// Returns the reconstructed plane, flat row-major of size `frameW * frameH`.
Int[] av1DecodeCoeffPlaneRecon(Int[] frame, Int stride, Int frameW, Int frameH,
                               Int bsize, Int txSz, Int txType,
                               Int mode, Int angleDelta,
                               Int useFilterIntra, Int filterIntraMode,
                               Int bitDepth, Int disableEdgeFilter,
                               Int intraEdgeFilterType,
                               Int maxBlocksWide, Int maxBlocksHigh,
                               Int dcQuant, Int acQuant,
                               Av1Symbol reader, Av1CoeffCdfStore store,
                               Int planeBsize, Int plane,
                               Int planeBlocksWide, Int planeBlocksHigh,
                               Int[] above, Int[] left, List<Int[]> levelsOut) {
    var order = av1DecodeBlockGridOrder(txSz, 0, 0, maxBlocksWide, maxBlocksHigh)
    var w = av1TxWidth(txSz)
    var h = av1TxHeight(txSz)
    // The frame carries a one-sample border, so the plane's interior lives at
    // `[1 .. frameW] x [1 .. frameH]` and the largest valid coordinate is
    // `frameW`/`frameH` (the predictor reads `frame[(y-1)*stride + ...]`).
    var maxX = frameW
    var maxY = frameH
    var edgeFilter = true
    if (disableEdgeFilter == 1) {
        edgeFilter = false
    }
    var n = order.size / 2
    var bi = 0
    while (bi < n) {
        var br = order.get(bi * 2)
        var bc = order.get(bi * 2 + 1)
        var x = bc << 2
        var y = br << 2
        var haveTop = 0
        if (br != 0) {
            haveTop = 1
        }
        var haveLeft = 0
        if (bc != 0) {
            haveLeft = 1
        }

        // 1. Decode the block's coefficients (slices 3e/3x) — the
        //    `read_coeffs_tx_intra_block` half of the pairing. This also stores
        //    the packed entropy context for the blocks that follow.
        var levels = av1DecodeCoeffsBlockEdge(reader, store, planeBsize, plane,
                br, bc, txSz, txType, above, left, planeBlocksWide,
                planeBlocksHigh)
        levelsOut.add(levels)

        // 2. Availability (slice 3ab): haveAboveRight/haveBelowLeft + nTopPx/nLeftPx.
        //    `sbSize` is BLOCK_64X64 (12) and the partition PARTITION_NONE (0),
        //    matching the oracle's `has_top_right`/`has_bottom_left` call.
        var avail = av1IntraAvail(12, bsize, 0, txSz, 0, 0, br, bc, mode,
                                  angleDelta, useFilterIntra, haveTop, haveLeft,
                                  0, 0, maxBlocksWide, maxBlocksHigh,
                                  frameW, frameH)
        var haveAboveRight = avail[0]
        var haveBelowLeft = avail[1]

        // 3. Prediction (slice 3u) from the already reconstructed neighbours.
        //    The block origin is the border-offset `(x + 1, y + 1)`.
        var pred = av1IntraPredictBlock(frame, stride, x + 1, y + 1, w, h,
                                        maxX, maxY,
                                        haveLeft, haveTop, haveAboveRight,
                                        haveBelowLeft, mode, angleDelta,
                                        useFilterIntra, filterIntraMode,
                                        bitDepth, intraEdgeFilterType, edgeFilter)

        // 4. Dequantize + inverse transform + reconstruct (slices 3f/3g/3i/3z)
        //    with the DECODED levels — the `predict_and_reconstruct` half.
        av1ReconBlockInto(frame, stride, x + 1, y + 1, levels, pred, txSz,
                          txType, bitDepth, false, dcQuant, acQuant)

        bi = bi + 1
    }

    // Copy the interior (border stripped) into a flat `frameW * frameH` plane.
    var out = new Int[frameW * frameH]
    var r = 0
    while (r < frameH) {
        var c = 0
        while (c < frameW) {
            out[r * frameW + c] = frame[(r + 1) * stride + (c + 1)]
            c = c + 1
        }
        r = r + 1
    }
    return out
}
