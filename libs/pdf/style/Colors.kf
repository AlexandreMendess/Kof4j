    static PdfColor green = PdfColor(22, 163, 74)
    static PdfColor blue = PdfColor(37, 99, 235)
    static PdfColor blueMedium = PdfColor(30, 64, 175)
    static PdfColor greyLight = PdfColor(229, 231, 235)
    static PdfColor greyMedium = PdfColor(156, 163, 175)
