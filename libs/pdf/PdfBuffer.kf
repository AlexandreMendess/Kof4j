package pdf

class PdfBuffer {
    List<String> parts
    Int length

    constructor() {
        parts = listOf<String>()
        length = 0
    }

    append(String value) {
        parts.add(value)
        length = length + value.length
    }

    content(): String {
        var content = ""
        for (var part in parts) {
            content = content + part
        }
        return content
    }
}
