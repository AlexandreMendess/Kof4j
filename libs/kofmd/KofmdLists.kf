package kofmd

import kofmd.KofmdTypes

class KofmdLists {
    newStrList(): List<String> {
        var seed = listOf("kofmd-seed")
        seed.clear()
        return seed
    }

    newIntList(): List<Int> {
        var seed = listOf(0)
        seed.clear()
        return seed
    }

    newFieldList(): List<KofmdField> {
        var seed = listOf(KofmdField("kofmd", "seed", false, KofmdLists().newStrList(), 0))
        seed.clear()
        return seed
    }

    newSchemaFieldList(): List<KofmdSchemaField> {
        var seed = listOf(KofmdSchemaField("kofmd", "String"))
        seed.clear()
        return seed
    }

    newSchemaList(): List<KofmdSchema> {
        var seed = listOf(KofmdSchema("Kofmd", KofmdLists().newSchemaFieldList()))
        seed.clear()
        return seed
    }
}
