package kofmd

record KofmdField(String name, String value, Bool quoted, List<String> items, Int line)

record KofmdBlock(List<String> intents, List<Int> intentLines, List<KofmdField> fields, List<String> prose)

record KofmdSchemaField(String name, String type)

record KofmdSchema(String name, List<KofmdSchemaField> fields)

record KofmdDoc(List<KofmdBlock> blocks)

class KofmdTool {
    parse(String text): KofmdDoc {
        var blockSeed = KofmdBlock(newStrList(), newIntList(), newFieldList(), newStrList())
        var blocks = listOf(blockSeed)
        blocks.clear()
        var fieldSeed = KofmdField("n", "v", false, newStrList(), 0)
        var intents = newStrList()
        var intentLines = newIntList()
        var currentLine = 0
        var fields = listOf(fieldSeed)
        fields.clear()
        var prose = newStrList()
        var inFence = false
        var pendingField = -1

        String[] lines = text.split("\n")
        for (var line in lines) {
            currentLine = currentLine + 1
            String rest = line
            if (rest.endsWith("\r")) {
                rest = rest.substring(0, rest.length - 1)
            }
            if (rest.startsWith("```")) {
                inFence = !inFence
                if (fields.size > 0 || prose.size > 0) {
                    blocks.add(KofmdBlock(intents, intentLines, fields, prose))
                    intents = newStrList()
                    intentLines = newIntList()
                    fields = listOf(fieldSeed)
                    fields.clear()
                    prose = newStrList()
                    pendingField = -1
                }
                prose = listOf(rest)
                var emptyIntents = newStrList()
                var emptyIntentLines = newIntList()
                var emptyFields = listOf(fieldSeed)
                emptyFields.clear()
                blocks.add(KofmdBlock(emptyIntents, emptyIntentLines, emptyFields, prose))
                prose = newStrList()
                continue
            }
            if (inFence) {
                prose.add(rest)
                continue
            }
            String trimmed = rest.trim()
            if (trimmed.length == 0) {
                if (fields.size > 0 || prose.size > 0 || intents.size > 0) {
                    blocks.add(KofmdBlock(intents, intentLines, fields, prose))
                    intents = newStrList()
                    intentLines = newIntList()
                    fields = listOf(fieldSeed)
                    fields.clear()
                    prose = newStrList()
                    pendingField = -1
                }
                continue
            }
            if (isIntentLine(trimmed)) {
                intents.add(trimmed.substring(1, trimmed.length))
                intentLines.add(currentLine)
                pendingField = -1
                continue
            }
            if (isListItem(trimmed)) {
                if (pendingField >= 0) {
                    String prior = fields.get(pendingField).value()
                    if (prior.length == 0) {
                        fields.get(pendingField).items().add(trimmed.substring(2, trimmed.length).trim())
                        continue
                    }
                }
                if (fields.size > 0 || prose.size > 0) {
                    blocks.add(KofmdBlock(intents, intentLines, fields, prose))
                    intents = newStrList()
                    intentLines = newIntList()
                    fields = listOf(fieldSeed)
                    fields.clear()
                    prose = newStrList()
                    pendingField = -1
                }
                prose.add(rest)
                continue
            }
            Int colon = fieldColon(rest)
            if (colon >= 0) {
                if (prose.size > 0) {
                    blocks.add(KofmdBlock(intents, intentLines, fields, prose))
                    intents = newStrList()
                    intentLines = newIntList()
                    fields = listOf(fieldSeed)
                    fields.clear()
                    prose = newStrList()
                }
                String name = rest.substring(0, colon).trim()
                String rawValue = rest.substring(colon + 1, rest.length).trim()
                Bool quoted = rawValue.startsWith("\"") && rawValue.endsWith("\"") && rawValue.length >= 2
                String value = rawValue
                if (quoted) {
                    value = rawValue.substring(1, rawValue.length - 1)
                }
                fields.add(KofmdField(name, value, quoted, newStrList(), currentLine))
                pendingField = fields.size - 1
                continue
            }
            if (isSchemaLine(trimmed)) {
                if (fields.size > 0 || prose.size > 0) {
                    blocks.add(KofmdBlock(intents, intentLines, fields, prose))
                    intents = newStrList()
                    intentLines = newIntList()
                    fields = listOf(fieldSeed)
                    fields.clear()
                    prose = newStrList()
                    pendingField = -1
                }
                prose = listOf(rest)
                var noFields = listOf(fieldSeed)
                noFields.clear()
                blocks.add(KofmdBlock(intents, intentLines, noFields, prose))
                intents = newStrList()
                intentLines = newIntList()
                prose = newStrList()
                continue
            }
            if (fields.size > 0 && prose.size == 0) {
                blocks.add(KofmdBlock(intents, intentLines, fields, prose))
                intents = newStrList()
                intentLines = newIntList()
                fields = listOf(fieldSeed)
                fields.clear()
                prose = newStrList()
                pendingField = -1
            }
            pendingField = -1
            prose.add(rest)
        }
        if (fields.size > 0 || prose.size > 0 || intents.size > 0) {
            blocks.add(KofmdBlock(intents, intentLines, fields, prose))
        }
        return KofmdDoc(blocks)
    }

    newStrList(): List<String> {
        var seed = listOf("kofmd-seed")
        seed.clear()
        return seed
    }

    newIntList(): List<Int> {
        var seed = listOf(0)
        seed.clear()
        return seed
    }

    newFieldList(): List<KofmdField> {
        var seed = listOf(KofmdField("kofmd", "seed", false, newStrList(), 0))
        seed.clear()
        return seed
    }

    newSchemaList(): List<KofmdSchema> {
        var seed = listOf(KofmdSchema("Kofmd", newSchemaFieldList()))
        seed.clear()
        return seed
    }

    newSchemaFieldList(): List<KofmdSchemaField> {
        var seed = listOf(KofmdSchemaField("kofmd", "String"))
        seed.clear()
        return seed
    }

    inferScalar(String raw, Bool quoted): String {
        if (quoted) {
            return "String"
        }
        if (raw == "true" || raw == "false") {
            return "Bool"
        }
        if (isIntLexeme(raw)) {
            return "Int"
        }
        if (isFloatLexeme(raw)) {
            return "Float"
        }
        return "String"
    }

    inferField(KofmdField field): String {
        if (field.items().size > 0) {
            return "List"
        }
        if (field.value().length == 0) {
            return "Absent"
        }
        return inferScalar(field.value(), field.quoted())
    }

    isIntLexeme(String raw): Bool {
        if (raw.length == 0) {
            return false
        }
        var start = 0
        if (raw.startsWith("-")) {
            if (raw.length == 1) {
                return false
            }
            start = 1
        }
        var index = start
        while (index < raw.length) {
            Int code = raw.charAt(index)
            if (code < 48 || code > 57) {
                return false
            }
            index = index + 1
        }
        return isInt32Range(raw)
    }

    isInt32Range(String raw): Bool {
        String digits = raw
        Bool negative = false
        if (raw.startsWith("-")) {
            negative = true
            digits = raw.substring(1, raw.length)
        }
        digits = stripLeadingZeros(digits)
        if (digits.length < 10) {
            return true
        }
        if (digits.length > 10) {
            return false
        }
        if (negative) {
            return digits.compareTo("2147483648") <= 0
        }
        return digits.compareTo("2147483647") <= 0
    }

    stripLeadingZeros(String digits): String {
        var index = 0
        while (index < digits.length) {
            if (digits.charAt(index) != 48) {
                break
            }
            index = index + 1
        }
        if (index >= digits.length) {
            return "0"
        }
        return digits.substring(index, digits.length)
    }

    isFloatLexeme(String raw): Bool {
        if (raw.length == 0) {
            return false
        }
        var rest = raw
        if (rest.startsWith("-") || rest.startsWith("+")) {
            if (rest.length == 1) {
                return false
            }
            rest = rest.substring(1, rest.length)
        }
        Int exp = exponentSplit(rest)
        String mantissa = rest
        if (exp >= 0) {
            mantissa = rest.substring(0, exp)
        }
        if (exp >= 0) {
            String tail = rest.substring(exp + 1, rest.length)
            if (!isExpTail(tail)) {
                return false
            }
        }
        Int dot = dotIndex(mantissa)
        if (dot < 0) {
            return exp >= 0 && allDigits(mantissa) && mantissa.length > 0
        }
        String head = mantissa.substring(0, dot)
        String frac = mantissa.substring(dot + 1, mantissa.length)
        if (frac.length == 0) {
            return false
        }
        if (!allDigits(frac)) {
            return false
        }
        if (head.length == 0) {
            return true
        }
        return allDigits(head)
    }

    dotIndex(String text): Int {
        var index = 0
        while (index < text.length) {
            if (text.charAt(index) == 46) {
                return index
            }
            index = index + 1
        }
        return -1
    }

    exponentSplit(String text): Int {
        var index = 0
        while (index < text.length) {
            Int code = text.charAt(index)
            if (code == 101 || code == 69) {
                return index
            }
            index = index + 1
        }
        return -1
    }

    isExpTail(String tail): Bool {
        if (tail.length == 0) {
            return false
        }
        var digits = tail
        if (tail.startsWith("-") || tail.startsWith("+")) {
            if (tail.length == 1) {
                return false
            }
            digits = tail.substring(1, tail.length)
        }
        return allDigits(digits) && digits.length > 0
    }

    allDigits(String text): Bool {
        if (text.length == 0) {
            return false
        }
        var index = 0
        while (index < text.length) {
            Int code = text.charAt(index)
            if (code < 48 || code > 57) {
                return false
            }
            index = index + 1
        }
        return true
    }

    parseSchemas(String text): List<KofmdSchema> {
        var seed = KofmdSchema("Kofmd", newSchemaFieldList())
        var schemas = listOf(seed)
        schemas.clear()
        String[] lines = text.split("\n")
        for (var line in lines) {
            String trimmed = line.trim()
            if (isSchemaLine(trimmed)) {
                var parsed = parseSchemaLine(trimmed)
                if (parsed.name().length > 0) {
                    schemas.add(parsed)
                }
            }
        }
        return schemas
    }

    parseSchemaLine(String trimmed): KofmdSchema {
        var empty = KofmdSchema("", newSchemaFieldList())
        if (!isSchemaLine(trimmed)) {
            return empty
        }
        String body = trimmed.substring(7, trimmed.length).trim()
        Int open = schemaParen(body)
        if (open < 0) {
            return empty
        }
        String name = body.substring(0, open).trim()
        if (!isTypeName(name)) {
            return empty
        }
        String inner = body.substring(open + 1, body.length - 1)
        var seed = KofmdSchemaField("kofmd", "String")
        var fields = listOf(seed)
        fields.clear()
        String[] parts = inner.split(",")
        for (var part in parts) {
            String entry = part.trim()
            if (entry.length == 0) {
                continue
            }
            String[] words = entry.split(" ")
            String typeName = ""
            String fieldName = ""
            for (var word in words) {
                String token = word.trim()
                if (token.length == 0) {
                    continue
                }
                if (typeName.length == 0) {
                    typeName = token
                    continue
                }
                if (fieldName.length == 0) {
                    fieldName = token
                }
            }
            if (typeName.length == 0 || fieldName.length == 0) {
                continue
            }
            if (!isTypeName(typeName)) {
                continue
            }
            if (!isFieldKey(fieldName)) {
                continue
            }
            fields.add(KofmdSchemaField(fieldName, typeName))
        }
        return KofmdSchema(name, fields)
    }

    schemaParen(String body): Int {
        var index = 0
        while (index < body.length) {
            if (body.charAt(index) == 40) {
                return index
            }
            index = index + 1
        }
        return -1
    }

    isTypeName(String name): Bool {
        if (name.length == 0) {
            return false
        }
        Int first = name.charAt(0)
        if (first < 65 || first > 90) {
            return false
        }
        var index = 1
        while (index < name.length) {
            Int code = name.charAt(index)
            Bool word = false
            if (code >= 65 && code <= 90) {
                word = true
            }
            if (code >= 97 && code <= 122) {
                word = true
            }
            if (code >= 48 && code <= 57) {
                word = true
            }
            if (code == 95) {
                word = true
            }
            if (!word) {
                return false
            }
            index = index + 1
        }
        return true
    }

    isFieldKey(String name): Bool {
        if (name.length == 0) {
            return false
        }
        Int first = name.charAt(0)
        if (first < 97 || first > 122) {
            return false
        }
        var index = 1
        while (index < name.length) {
            Int code = name.charAt(index)
            Bool word = false
            if (code >= 97 && code <= 122) {
                word = true
            }
            if (code >= 48 && code <= 57) {
                word = true
            }
            if (code == 95) {
                word = true
            }
            if (!word) {
                return false
            }
            index = index + 1
        }
        return true
    }

    validateField(KofmdField field, KofmdSchema schema): String {
        Int slot = schemaSlot(schema, field.name())
        if (slot < 0) {
            return ""
        }
        String want = schema.fields().get(slot).type()
        if (want.endsWith("?")) {
            want = want.substring(0, want.length - 1)
        }
        if (field.items().size > 0) {
            return "MD002"
        }
        if (field.value().length == 0) {
            return ""
        }
        String got = inferScalar(field.value(), field.quoted())
        if (got == want) {
            return ""
        }
        if (want == "String") {
            return ""
        }
        if (want == "Float" && got == "Int") {
            return ""
        }
        return "MD002"
    }

    schemaSlot(KofmdSchema schema, String name): Int {
        var index = 0
        while (index < schema.fields().size) {
            if (schema.fields().get(index).name() == name) {
                return index
            }
            index = index + 1
        }
        return -1
    }

    validateBlock(KofmdBlock block, KofmdSchema schema): List<String> {
        var diags = newStrList()
        var index = 0
        while (index < block.fields().size) {
            KofmdField field = block.fields().get(index)
            String diag = validateField(field, schema)
            if (diag.length > 0) {
                diags.add(diag + ":" + field.line().toString() + ":" + field.name())
            }
            index = index + 1
        }
        return diags
    }

    validateDoc(KofmdDoc doc, KofmdSchema schema): List<String> {
        var diags = newStrList()
        var index = 0
        while (index < doc.blocks().size) {
            List<String> blockDiags = validateBlock(doc.blocks().get(index), schema)
            var inner = 0
            while (inner < blockDiags.size) {
                diags.add(blockDiags.get(inner))
                inner = inner + 1
            }
            index = index + 1
        }
        return diags
    }

    isKnownIntent(String name): Bool {
        return setOf(
            "information", "decision", "requirement", "task", "question",
            "answer", "result", "warning", "configuration", "example", "api",
            "message", "explanation", "release"
        ).contains(name)
    }

    isKnownInstruction(String token): Bool {
        return setOf(
            "inspect", "preserve-api", "no-breaking-change", "run-tests",
            "update-docs", "do-not-refactor", "verify-backends", "add-tests",
            "implement", "test"
        ).contains(token)
    }

    keyLabel(String key): String {
        if (key == "last" || key == "doing" || key == "next") {
            return "continuity"
        }
        if (key == "location") {
            return "context"
        }
        if (key == "state") {
            return "status"
        }
        if (key == "instructions") {
            return "action"
        }
        if (key == "constraint") {
            return "rule"
        }
        if (key == "decision") {
            return "fact"
        }
        if (key == "result") {
            return "outcome"
        }
        if (key == "question" || key == "answer") {
            return "dialogue"
        }
        if (key == "reason" || key == "symbol") {
            return "modifier"
        }
        return ""
    }

    isAdvisoryValue(String key, String value): Bool {
        if (key == "state") {
            return setOf("active", "blocked", "done", "failed").contains(value)
        }
        if (key == "result") {
            return setOf("pass", "fail", "blocked").contains(value)
        }
        return false
    }

    validateVocabulary(KofmdDoc doc): List<String> {
        var diags = newStrList()
        var blockIndex = 0
        while (blockIndex < doc.blocks().size) {
            KofmdBlock block = doc.blocks().get(blockIndex)
            var intentIndex = 0
            while (intentIndex < block.intents().size) {
                String intent = block.intents().get(intentIndex)
                if (!isKnownIntent(intent)) {
                    diags.add("MD002:" + block.intentLines().get(intentIndex).toString() + ":@" + intent)
                }
                intentIndex = intentIndex + 1
            }
            var fieldIndex = 0
            while (fieldIndex < block.fields().size) {
                KofmdField field = block.fields().get(fieldIndex)
                if (field.name() == "instructions" && hasProseToken(field)) {
                    diags.add("MD002:" + field.line().toString() + ":instructions")
                }
                fieldIndex = fieldIndex + 1
            }
            blockIndex = blockIndex + 1
        }
        return diags
    }

    hasProseToken(KofmdField field): Bool {
        var index = 0
        while (index < field.items().size) {
            if (field.items().get(index).contains(" ")) {
                return true
            }
            index = index + 1
        }
        return field.items().size == 0 && field.value().contains(" ")
    }

    renderMarkdown(KofmdDoc doc): String {
        var out = ""
        var insideFence = false
        var index = 0
        while (index < doc.blocks().size) {
            out = out + renderBlock(doc.blocks().get(index))
            if (isFenceMarker(doc.blocks().get(index))) {
                insideFence = !insideFence
            }
            if (!insideFence && index + 1 < doc.blocks().size) {
                out = out + "\n"
            }
            index = index + 1
        }
        return out
    }

    renderBlock(KofmdBlock block): String {
        var out = ""
        var index = 0
        while (index < block.intents().size) {
            out = out + "@" + block.intents().get(index) + "\n"
            index = index + 1
        }
        index = 0
        while (index < block.fields().size) {
            out = out + renderField(block.fields().get(index))
            index = index + 1
        }
        index = 0
        while (index < block.prose().size) {
            out = out + block.prose().get(index) + "\n"
            index = index + 1
        }
        return out
    }

    renderField(KofmdField field): String {
        if (field.items().size > 0) {
            var out = field.name() + ":\n"
            var index = 0
            while (index < field.items().size) {
                out = out + "  - " + field.items().get(index) + "\n"
                index = index + 1
            }
            return out
        }
        if (field.value().length == 0) {
            return field.name() + ":\n"
        }
        if (field.quoted()) {
            return field.name() + ": \"" + field.value() + "\"\n"
        }
        return field.name() + ": " + field.value() + "\n"
    }

    isFenceMarker(KofmdBlock block): Bool {
        if (block.intents().size > 0 || block.fields().size > 0) {
            return false
        }
        if (block.prose().size != 1) {
            return false
        }
        return block.prose().get(0).startsWith("```")
    }

    format(KofmdDoc doc): String {
        return renderMarkdown(canonicalize(doc))
    }

    canonicalize(KofmdDoc doc): KofmdDoc {
        var seed = KofmdBlock(newStrList(), newIntList(), newFieldList(), newStrList())
        var blocks = listOf(seed)
        blocks.clear()
        var index = 0
        while (index < doc.blocks().size) {
            blocks.add(sortFields(doc.blocks().get(index)))
            index = index + 1
        }
        return KofmdDoc(blocks)
    }

    sortFields(KofmdBlock block): KofmdBlock {
        var seed = KofmdField("kofmd", "seed", false, newStrList(), 0)
        var fields = listOf(seed)
        fields.clear()
        var index = 0
        while (index < block.fields().size) {
            fields.add(block.fields().get(index))
            index = index + 1
        }
        var i = 0
        while (i < fields.size) {
            var j = i + 1
            while (j < fields.size) {
                if (keyLess(fields.get(j).name(), fields.get(i).name())) {
                    var temp = fields.get(i)
                    fields.set(i, fields.get(j))
                    fields.set(j, temp)
                }
                j = j + 1
            }
            i = i + 1
        }
        var intents = newStrList()
        var intentLines = newIntList()
        var k = 0
        while (k < block.intents().size) {
            intents.add(block.intents().get(k))
            intentLines.add(block.intentLines().get(k))
            k = k + 1
        }
        var prose = newStrList()
        var p = 0
        while (p < block.prose().size) {
            prose.add(block.prose().get(p))
            p = p + 1
        }
        return KofmdBlock(intents, intentLines, fields, prose)
    }

    keyLess(String a, String b): Bool {
        var rankA = continuityRank(a)
        var rankB = continuityRank(b)
        if (rankA != rankB) {
            return rankA < rankB
        }
        return byteLess(a, b)
    }

    continuityRank(String key): Int {
        if (key == "last") {
            return 0
        }
        if (key == "doing") {
            return 1
        }
        if (key == "next") {
            return 2
        }
        if (key == "location") {
            return 3
        }
        if (key == "state") {
            return 4
        }
        return 5
    }

    byteLess(String a, String b): Bool {
        var limit = a.length
        if (b.length < limit) {
            limit = b.length
        }
        var index = 0
        while (index < limit) {
            Int ca = a.charAt(index)
            Int cb = b.charAt(index)
            if (ca != cb) {
                return ca < cb
            }
            index = index + 1
        }
        return a.length < b.length
    }

    isIntentLine(String trimmed): Bool {
        if (!trimmed.startsWith("@")) {
            return false
        }
        if (trimmed.length < 2) {
            return false
        }
        if (trimmed.contains(" ") || trimmed.contains(":")) {
            return false
        }
        return true
    }

    isListItem(String trimmed): Bool {
        if (!trimmed.startsWith("- ")) {
            return false
        }
        return trimmed.length > 2
    }

    fieldColon(String line): Int {
        if (line.length == 0) {
            return -1
        }
        Int first = line.charAt(0)
        if (first < 97 || first > 122) {
            return -1
        }
        var index = 0
        while (index < line.length) {
            Int code = line.charAt(index)
            Bool keyChar = false
            if (code >= 97 && code <= 122) {
                keyChar = true
            }
            if (code >= 48 && code <= 57) {
                keyChar = true
            }
            if (code == 95) {
                keyChar = true
            }
            if (!keyChar) {
                break
            }
            index = index + 1
        }
        if (index == 0 || index >= line.length) {
            return -1
        }
        if (line.charAt(index) != 58) {
            return -1
        }
        return index
    }

    isSchemaLine(String trimmed): Bool {
        if (!trimmed.startsWith("record ")) {
            return false
        }
        if (!trimmed.contains("(")) {
            return false
        }
        return trimmed.endsWith(")")
    }
}
