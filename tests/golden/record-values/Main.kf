record Ponto(Int x, Int y)
record Rotulo(String texto, Int peso)
main() {
    var p = Ponto(1, 2)
    println(p)
    println(p == Ponto(1, 2))
    println(p == Ponto(1, 3))
    println(Ponto(1, 2) == Ponto(1, 2))
    var r = Rotulo("k", 7)
    println(r)
    println(r == Rotulo("k", 7))
    println(r == Rotulo("k", 8))
    var l = listOf(Ponto(1, 1), Ponto(2, 2))
    println(l)
    println(l.size)
    println(l.contains(Ponto(2, 2)))
    println(l.contains(Ponto(9, 9)))
    var m = mapOf("a", Ponto(3, 4))
    println(m.get("a"))
    println(m.get("a") == Ponto(3, 4))
    println(m.containsKey("a"))
    println("end")
}
