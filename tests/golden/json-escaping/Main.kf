main() {
    println(json.encode("plain"))
    println(json.encode("tab\there"))
    println(json.encode("new\nline"))
    println(json.encode("cr\rhere"))
    println(json.encode("quote\"and\\back"))
    println(json.encode("slash/forward"))
    println(json.encode("café"))
    println(json.encode(""))
    var l = json.decode<List<String>>("[\"x\",\"y\"]")
    println(l.get(0) + l.get(1))
    var s = json.decode<String>("\"hello\"")
    println(s)
    println(json.decode<String>("\"x\\ty\""))
    println(json.decode<String>("\"x\\ny\"").length)
    println(json.decode<String>("\"x\\\\y\""))
    println(json.decode<String>("\"x\\\"y\""))
    println(json.decode<String>("\"a\\/b\""))
    println(json.decode<String>("\"\\b\\f\"").length)
    println(json.decode<String>("\"\\u0041\""))
    println(json.decode<String>("\"caf\\u00e9\""))
    println(json.decode<String>("\"\\u4e2d\""))
}
