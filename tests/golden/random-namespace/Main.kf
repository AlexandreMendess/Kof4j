main() {
    println(random.randomInt(0))
    println(random.randomInt(-5))
    println(random.randomInt(1))
    println(random.randomString(0, "abc").length)
    println(random.randomString(-3, "ab").length)
    println(random.randomString(5, "").length)
    println(random.hex(0) == null)
    println(random.hex(-1) == null)
    println(random.hex(-100) == null)
    println(random.hex(4).length)
    println(random.hex(1).length)
    println(random.hex(16).length)
    var r = random.randomInt(1000)
    println(r >= 0)
    println(r < 1000)
    var s = random.randomString(6, "ab")
    println(s.length)
}
