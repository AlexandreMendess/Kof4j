main() {
    var a = listOf("a", "b", "c")
    var b = listOf("x", "y")
    var z = a.zip(b)
    println(z.size)
    println(z.get(0).first)
    println(z.get(0).second)
    println(z.get(1).first)
    println(z.get(1).second)
    var equal = listOf("m", "n").zip(listOf("p", "q"))
    println(equal.size)
    println(equal.get(1).first + equal.get(1).second)
    var emptyRight = listOf("solo").drop(1)
    println(listOf("solo").zip(emptyRight).size)
    var emptyLeft = listOf("z").drop(1)
    println(emptyLeft.zip(listOf("z")).size)
    var joined = listOf("k").zip(listOf("v"))
    println(joined.get(0).first + "=" + joined.get(0).second)
    println("end")
}
