record Point(Int x, Int y)
record User(String name, Int age)
record Flag(Bool ok)
main() {
    println(json.encode(Point(3, 4)))
    println(json.encode(User("ada", 36)))
    var p = json.decode<Point>("{\"x\":7,\"y\":8}")
    println(p.x() + p.y())
    var u = json.decode<User>("{\"name\":\"grace\",\"age\":45}")
    println(u.name() + "/" + u.age())
    println(json.encode(listOf(Point(1, 2), Point(3, 4))))
    println(json.encode(listOf("a", "b")))
    println(json.encode(Flag(true)))
    println(json.encode(listOf(Flag(true), Flag(false))))
    println(json.encode(User("a\"b\nc", 1)))
    var w = json.decode<Point>("  {  \"x\" : 5 , \"y\" : 6 }  ")
    println(w.x() + w.y())
    var e = json.decode<Point>("{\"x\":1,\"y\":2,\"z\":9}")
    println(e.x() + e.y())
}
