main() {
    println(math.pow(2.0, 10.0))
    println(math.pow(3.0, 2.0))
    println(math.pow(9.0, 0.5))
    println(math.pow(4.0, 0.5))
    println(math.pow(2.0, 20.0))
    println(math.pow(10.0, 3.0))
    println(math.pow(5.0, 1.0))
    println(math.pow(2.0, 0.0))
    println(math.pow(0.0, 0.0))
    println(math.pow(2.0, -1.0))
    println(math.pow(-2.0, 3.0))
    println(math.pi())
    println(math.e())
    println(math.tau())
    println(math.tau() == 2.0 * math.pi())
    println(math.pi() > math.e())
    println(math.e() > math.tau())
}
