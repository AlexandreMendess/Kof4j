main() {
    println("".isEmpty())
    println("x".isEmpty())
    println("hello".contains("ell"))
    println("hello".contains("z"))
    println("hello".lastIndexOf("l"))
    println("hello".lastIndexOf("z"))
    println("hello".lastIndexOf("l", 2))
    println("hello".lastIndexOf("l", 0))
    println("ab".concat("cd"))
    println("a-b-c".replace("-", "_"))
    println("abc".replace("a", "XY"))
    println("abc".replace('a', 'X'))
    println("abc".substring(1, 3))
    println("hello".startsWith("llo", 2))
    println("hello".startsWith("llo", 1))
    println("hello".indexOf("l", 3))
    println("hello".indexOf("z", 0))
    println("abc".compareTo("abd"))
    println("abc".compareTo("abc"))
    println("ABC".compareToIgnoreCase("abc"))
    println("42".toInt())
    println("9000000000".toLong())
    println("3.5".toDouble())
    var p1 = "a,b,c".split(",", 2)
    println(p1.length)
    println(p1[0] + "|" + p1[1])
    println("a,,b,,".split(",", 0).length)
    var p3 = "a,,b,,".split(",", -1)
    println(p3.length)
    println(p3[4] + ".")
    var p4 = "a,,b,,".split(",", 2)
    println(p4.length)
    println(p4[1])
    println("a,,b,,".split(",", 5).length)
    println("".split(",", 3).length)
    println("abc".split(",", 2).length)
}
