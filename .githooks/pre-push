#!/usr/bin/env bash
#
# pre-push — roda scripts/codeql-gate.sh --fast (só o GATE 1: API de alerts,
# sem build) antes de QUALQUER push. A suíte completa continua sendo a porta
# do commit (AGENTS.md Q1/Q2); este hook pega o caso barato: alerta novo que
# ninguém abriu na UI.
#
# #555: o skip nao e mais um "exit 0" silencioso deste hook. Ele vive no
# scripts/codeql-gate.sh: exige MOTIVO nao-vazio
# (CODEQL_GATE_SKIP="<causa de uma frase>"), grita um banner, deixa rastro em
# .git/codeql-gate-skips.log e e IGNORADO dentro de CI. Skip virou norma uma
# vez (o portao quebrava todo push); o baseline (scripts/codeql-baseline.txt)
# e o caminho certo: triagem registrada com dono e data, nao pulo.
set -uo pipefail
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -x "$root/scripts/codeql-gate.sh" ] || exit 0
for marker in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
    [ -e "$root/.git/$marker" ] && exit 0
done
# rc do gate: 0 = verde; 1 = alerta novo (bloqueia); 2 = INCONCLUSIVO (API
# fora/limit — nada verificado). rc=2 NAO bloqueia: a porta real e o scan do
# CI (codeql.yml); travar push por indisponibilidade de API deixaria o repo
# inteiro impedido (licao 15/09 ~18:45: secondary rate limit das maquinas).
"$root/scripts/codeql-gate.sh" --fast
rc=$?
[ "$rc" = 2 ] && echo "pre-push: GATE 1 nao avaliado (API fora) — push segue; o CI e a porta" && exit 0
exit "$rc"
